Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\.TCEPACKAGE]
@="Titan.TCEPackageFile"

[HKEY_CURRENT_USER\Software\Classes\Titan.TCEPackageFile]
@="Titan Environment Data Package"

[HKEY_CURRENT_USER\Software\Classes\Titan.TCEPackageFile\shell\open\command]
@="\"C:\\titan\\titan.exe\" --install-tcepackage \"%1\""
